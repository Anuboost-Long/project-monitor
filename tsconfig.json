{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": "./src",
		"outDir": "dist",
		"jsx": "react-jsx",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true
	}
}
