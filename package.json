{
	"name": "project-monitor",
	"productName": "Project Monitor",
	"version": "1.0.0",
	"description": "Monitor local project commands, terminal output, and captured errors from one desktop workspace.",
	"main": ".vite/build/main.js",
	"private": true,
	"scripts": {
		"start": "electron-forge start",
		"package": "electron-forge package",
		"package:mac": "electron-forge make --platform=darwin --arch=arm64",
		"package:win": "electron-forge make --platform=win32 --arch=x64",
		"make": "electron-forge make",
		"make:mac": "electron-forge make --platform=darwin --arch=arm64",
		"make:win": "electron-forge make --platform=win32 --arch=x64",
		"publish": "electron-forge publish",
		"publish:mac": "electron-forge publish --platform=darwin --arch=arm64",
		"publish:win": "electron-forge publish --platform=win32 --arch=x64",
		"lint": "eslint --ext .ts,.tsx,.mts .",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run lint"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Anuboost-Long/project-monitor.git"
	},
	"homepage": "https://github.com/Anuboost-Long/project-monitor",
	"keywords": [
		"electron",
		"monitoring",
		"terminal",
		"developer-tools"
	],
	"author": {
		"name": "Ly kimlong",
		"email": "104675801+Anuboost-Long@users.noreply.github.com"
	},
	"license": "MIT",
	"devDependencies": {
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-deb": "^7.11.2",
		"@electron-forge/maker-dmg": "^7.11.2",
		"@electron-forge/maker-rpm": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
		"@electron-forge/plugin-fuses": "^7.11.2",
		"@electron-forge/plugin-vite": "^7.11.2",
		"@electron-forge/publisher-github": "^7.11.2",
		"@electron/fuses": "^1.8.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/electron-squirrel-startup": "^1.0.2",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"@vitejs/plugin-react": "^4.3.4",
		"electron": "44.0.0",
		"eslint": "^8.57.1",
		"eslint-plugin-import": "^2.32.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.8.3",
		"vite": "^5.4.21"
	},
	"dependencies": {
		"@fontsource-variable/kode-mono": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"axios": "^1.20.0",
		"clsx": "^2.1.1",
		"electron-squirrel-startup": "^1.0.1",
		"node-pty": "^1.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.14.2",
		"tailwind-merge": "^3.6.0"
	}
}
